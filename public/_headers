# Keep the pages.dev address out of search engines. It is a working preview, not the public site.
# Scoped to that hostname on purpose: it covers every file (photos too), and it stops applying by
# itself the day a real domain is attached — nothing to remember to remove at launch.
https://mrtycoon.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted media never changes — cache it hard.
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/assets/frames/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML must never be stale, or a deploy won't be visible.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
